[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 180
    origin = top-right
    offset = (12, 50)
    notification_limit = 5
    font = JetBrains Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#5caeff"
    corner_radius = 12
    corners = all
    gap_size = 8
    separator_height = 2
    sort = yes
    stack_duplicates = true
    sticky_history = yes
    history_length = 20
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0c1529"
    foreground = "#d9eaff"
    frame_color = "#315b83"
    timeout = 4

[urgency_normal]
    background = "#111f38"
    foreground = "#edf5ff"
    frame_color = "#5caeff"
    timeout = 6

[urgency_critical]
    background = "#172033"
    foreground = "#ffffff"
    frame_color = "#ff6384"
    timeout = 0
