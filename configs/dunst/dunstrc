[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 180
    origin = top-right
    offset = (12, 50)
    notification_limit = 5
    font = JetBrains Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#ff477f"
    corner_radius = 12
    corners = all
    gap_size = 8
    separator_height = 2
    sort = yes
    stack_duplicates = true
    sticky_history = yes
    history_length = 20
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#111322"
    foreground = "#d9d5e4"
    frame_color = "#66405b"
    timeout = 4

[urgency_normal]
    background = "#15162b"
    foreground = "#f5edf6"
    frame_color = "#ff477f"
    timeout = 6

[urgency_critical]
    background = "#270f20"
    foreground = "#ffffff"
    frame_color = "#ff315f"
    timeout = 0
