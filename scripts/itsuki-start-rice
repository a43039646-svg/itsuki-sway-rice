#!/usr/bin/env bash
set -uo pipefail

CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
WALLPAPER="$HOME/Pictures/Wallpapers/itsuki.png"
LOG_DIR="$CACHE_HOME/itsuki-sway-rice"
LOG_FILE="$LOG_DIR/startup.log"

mkdir -p "$LOG_DIR"
touch "$LOG_FILE"

restart_service() {
  local process="$1"
  shift
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '[%s] Missing command: %s\n' "$(date -Is)" "$1" >>"$LOG_FILE"
    return 1
  fi
  pkill -x "$process" >/dev/null 2>&1 || true
  sleep 0.2
  "$@" >>"$LOG_FILE" 2>&1 &
}

restart_service waybar waybar || true
restart_service dunst dunst || true

pkill -x swaybg >/dev/null 2>&1 || true
sleep 0.2
if command -v swaybg >/dev/null 2>&1 && [[ -r "$WALLPAPER" ]]; then
  swaybg -i "$WALLPAPER" -m fill >>"$LOG_FILE" 2>&1 &
else
  printf '[%s] swaybg or wallpaper is unavailable: %s\n' "$(date -Is)" "$WALLPAPER" >>"$LOG_FILE"
fi
