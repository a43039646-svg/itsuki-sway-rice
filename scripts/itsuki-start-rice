#!/usr/bin/env bash
set -uo pipefail

CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
LOG_DIR="$CACHE_HOME/itsuki-sway-rice"
LOG_FILE="$LOG_DIR/startup.log"

mkdir -p "$LOG_DIR"
touch "$LOG_FILE"

restart_service() {
  local process="$1"
  shift
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '[%s] Missing command: %s\n' "$(date -Is)" "$1" >>"$LOG_FILE"
    return 1
  fi
  pkill -x "$process" >/dev/null 2>&1 || true
  sleep 0.2
  "$@" >>"$LOG_FILE" 2>&1 &
}

restart_service waybar waybar || true
restart_service dunst dunst || true

# Only manage the background when the installer stored an explicit selection.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
WALLPAPER_MARKER="$CONFIG_HOME/sway/itsuki-wallpaper.path"
if [[ -r "$WALLPAPER_MARKER" ]]; then
  WALLPAPER=""
  IFS= read -r WALLPAPER < "$WALLPAPER_MARKER" || true
  if [[ -n "$WALLPAPER" && -r "$WALLPAPER" ]] && command -v swaybg >/dev/null 2>&1; then
    pkill -x swaybg >/dev/null 2>&1 || true
    sleep 0.2
    swaybg -i "$WALLPAPER" -m fill >>"$LOG_FILE" 2>&1 &
  else
    printf '[%s] Managed wallpaper is missing or swaybg is unavailable: %s\n' "$(date -Is)" "$WALLPAPER" >>"$LOG_FILE"
  fi
fi
